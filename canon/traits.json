[
  {
    "who": "老周",
    "trait": "走路两短一长，右脚落得轻；上楼扶栏杆一步一停，十七级楼梯走三十七步",
    "fromChapter": 1
  },
  {
    "who": "老周",
    "trait": "看东西前先用手背蹭、凑鼻子闻，再对着光数纸的帘纹",
    "fromChapter": 1
  },
  {
    "who": "沈砚",
    "trait": "抄书时每回翻页习惯把折角按平",
    "fromChapter": 1
  },
  {
    "who": "老周",
    "trait": "捻纸用拇指肚搓页角往上挑，不伤纸。",
    "fromChapter": 2
  },
  {
    "who": "老周",
    "trait": "说话前先咳一声。",
    "fromChapter": 2
  },
  {
    "who": "沈砚",
    "trait": "走楼梯第七级活板时故意踩响，不绕。",
    "fromChapter": 2
  },
  {
    "who": "shenyan",
    "trait": "写字撇的收笔总往下带钩，像记账的",
    "fromChapter": 3
  },
  {
    "who": "shenyan",
    "trait": "抄书三年，闭着眼都能分辨松烟与油烟两种墨色",
    "fromChapter": 3
  },
  {
    "who": "shenyan",
    "trait": "数数习惯：数檐水滴十七下、数灯焰歪正九下",
    "fromChapter": 3
  },
  {
    "who": "liuqingwu",
    "trait": "进门先逐格看架子，眼睛走得很慢；说话简短，报名字时眼睛只在对方脸上过一下。",
    "fromChapter": 4
  },
  {
    "who": "laozhou",
    "trait": "左手翻书，右手三根指头压在书脊上；喘气时瞎眼朝着人；走路没有声音。",
    "fromChapter": 4
  },
  {
    "who": "shenyan",
    "trait": "抄书时手心从不出汗，遇事把笔搁下翻回前一页装作对字。",
    "fromChapter": 4
  },
  {
    "who": "aman",
    "trait": "紧张时把两只手背到身后，手指绞在一起",
    "fromChapter": 5
  },
  {
    "who": "aman",
    "trait": "说话一个字一个字往外放，说得很慢",
    "fromChapter": 5
  },
  {
    "who": "shenyan",
    "trait": "追问时只说“我不问第二遍”，抓住对方肩膀逼问",
    "fromChapter": 5
  },
  {
    "who": "liuqingwu",
    "trait": "走路脚步三下一样重，执法堂的人练过。",
    "fromChapter": 6
  },
  {
    "who": "laozhou",
    "trait": "咳嗽拖得长，像在数；挂掸子要对齐靠、挂歪了要扶正。",
    "fromChapter": 6
  },
  {
    "who": "shenyan",
    "trait": "写完字习惯在册子边上刮笔尖，刮出一小弯。",
    "fromChapter": 6
  },
  {
    "who": "laozhou",
    "trait": "说话时眼睛落在账册上不看来人，合账册时用手掌把边对齐并拍两下",
    "fromChapter": 7
  },
  {
    "who": "shenyan",
    "trait": "擦窗时布脏了把脏面折进去接着擦；记位置用指甲在木头上掐印",
    "fromChapter": 7
  },
  {
    "who": "老周",
    "trait": "念册子时一字一字往外递，念得很慢；沈砚问一句他就从头重念一遍。",
    "fromChapter": 8
  },
  {
    "who": "老周",
    "trait": "起身时膝盖响一声；掖左眼上的布掖得很仔细，像掖一床被子。",
    "fromChapter": 8
  },
  {
    "who": "沈砚",
    "trait": "抄录时习惯在纸边记数、在字旁点小点标错处。",
    "fromChapter": 8
  },
  {
    "who": "laozhou",
    "trait": "掂旧账时拇指压在账脊上，压一下松一下，共压四下",
    "fromChapter": 9
  },
  {
    "who": "laozhou",
    "trait": "说话短促，问「擦掉了没有」，答「擦不掉就对了」便转身下楼，脚步声三下一样重",
    "fromChapter": 9
  },
  {
    "who": "aman",
    "trait": "蹲在门坎上啃冷馍，啃两口把剩下半块往沈砚手里塞",
    "fromChapter": 9
  },
  {
    "who": "xuanqing",
    "trait": "说话平缓，吩咐收签时像吩咐人收一本抄坏的书；数数时手指在案面上轻叩，像数一叠纸。",
    "fromChapter": 10
  },
  {
    "who": "shenyan",
    "trait": "捧册时习惯把册往怀里拢，指头沾灰在裤腿上蹭掉；紧张时捏袖口捏出褶。",
    "fromChapter": 10
  },
  {
    "who": "liudaren",
    "trait": "站在签板旁手按刀柄按得很实，不说话时只是看着签筒。",
    "fromChapter": 10
  },
  {
    "who": "laozhou",
    "trait": "说话时习惯捻断指残根，眼睛看别处。",
    "fromChapter": 11
  },
  {
    "who": "liuqingwu",
    "trait": "说话前先理袖口，用指甲刮字迹辨墨。",
    "fromChapter": 11
  },
  {
    "who": "aman",
    "trait": "紧张时把手在围裙上反复擦。",
    "fromChapter": 11
  },
  {
    "who": "laozhou",
    "trait": "走路脚步声两短一长。",
    "fromChapter": 12
  },
  {
    "who": "laozhou",
    "trait": "说话常改口，改得很快，像揭一张贴反了的封皮又摁回去。",
    "fromChapter": 12
  },
  {
    "who": "guanshi",
    "trait": "说话时拿竹片刮砚台，刮一下吹一下，眼不抬。",
    "fromChapter": 12
  },
  {
    "who": "liuqingwu",
    "trait": "执法堂规矩，坐下也不靠背，坐得很直",
    "fromChapter": 13
  },
  {
    "who": "liuqingwu",
    "trait": "说话平直，关键处用「像」字说得很轻",
    "fromChapter": 13
  },
  {
    "who": "laozhou",
    "trait": "上梯数得很慢，一级一级，两短一长后停住再上",
    "fromChapter": 13
  },
  {
    "who": "liuqingwu",
    "trait": "走路脚步三下一样重。",
    "fromChapter": 14
  },
  {
    "who": "laozhou",
    "trait": "下梯子时脚步两短一长。",
    "fromChapter": 14
  },
  {
    "who": "laozhou",
    "trait": "说话前喉咙里会先响一声，像纸从中间撕到一半停住。",
    "fromChapter": 14
  },
  {
    "who": "laozhou",
    "trait": "说话极短，常用“嗯”应声，不愿答时便挪到晒书板后头或蹲下翻旧档，不正面看人。",
    "fromChapter": 15
  },
  {
    "who": "aman",
    "trait": "进门前脚在门槛上蹭两下，鼻子下常挂着一点自己不知道。",
    "fromChapter": 15
  },
  {
    "who": "liuqingwu",
    "trait": "走路三下一样重，说话引律条，手常按在刀柄上。",
    "fromChapter": 15
  },
  {
    "who": "laozhou",
    "trait": "心里搁着事就摸后脖颈",
    "fromChapter": 16
  },
  {
    "who": "laozhou",
    "trait": "有心事时脚步由两短一长变为一长两短，右脚仍落得轻",
    "fromChapter": 16
  },
  {
    "who": "shenyan",
    "trait": "叠衣用老周叠账册的手法：对齐边、拍两下",
    "fromChapter": 16
  },
  {
    "who": "shenyan",
    "trait": "写“沈”字时三点水第一点总起得低，练十年抬不上去。",
    "fromChapter": 17
  },
  {
    "who": "aman",
    "trait": "写字一竖总往右倒，收笔往回勾一下。",
    "fromChapter": 17
  },
  {
    "who": "laozhou",
    "trait": "缠麻绳到第七圈打结，用三根指头按紧",
    "fromChapter": 18
  },
  {
    "who": "laozhou",
    "trait": "走路脚步声两短一长，踩到第七级活梯级停两息",
    "fromChapter": 18
  },
  {
    "who": "liuqingwu",
    "trait": "说话时手在袖口上按一下",
    "fromChapter": 18
  },
  {
    "who": "shenyan",
    "trait": "写“沈”字三点水第一点起笔低一分，改了十年改不掉",
    "fromChapter": 19
  },
  {
    "who": "shenyan",
    "trait": "掐墨掐锭腰不掐锭头，因锭头太脆一掐就崩",
    "fromChapter": 19
  },
  {
    "who": "laozhou",
    "trait": "右手拇指有一道疤，自称年轻时裁纸裁的",
    "fromChapter": 19
  },
  {
    "who": "老周",
    "trait": "走路左脚落得重、右脚落得轻，两短一长",
    "fromChapter": 20
  },
  {
    "who": "老周",
    "trait": "叠衣裳不压边，领口总有褶子",
    "fromChapter": 20
  },
  {
    "who": "玄清",
    "trait": "说话时眼睛看着对方不躲，手却往袖子里缩半寸摸东西",
    "fromChapter": 20
  },
  {
    "who": "zhouwujiu",
    "trait": "走路左脚重右脚轻，慢",
    "fromChapter": 22
  },
  {
    "who": "zhouwujiu",
    "trait": "掖左眼布时一角一角仔细掖进去，像掖被子",
    "fromChapter": 22
  },
  {
    "who": "shenyan",
    "trait": "掐墨锭掐锭腰不掐锭头，掐出半月形弯印",
    "fromChapter": 22
  },
  {
    "who": "shenyan",
    "trait": "抄书十年，撇画收笔带钩，老周说像记账的。",
    "fromChapter": 23
  },
  {
    "who": "shenyan",
    "trait": "抄书姿势：左手压纸角，右手腕贴案沿，腕不动，动指头",
    "fromChapter": 24
  },
  {
    "who": "aman",
    "trait": "站立时左脚总往外撇，说是老家挑水挑的，撇了二十年正不回来",
    "fromChapter": 24
  },
  {
    "who": "shenyan",
    "trait": "捧册姿势：指头先拢边，再往怀里带，沾了灰在襟上蹭掉",
    "fromChapter": 24
  },
  {
    "who": "liuqingwu",
    "trait": "进门先逐格看架子，眼睛从东头走到西头再回来",
    "fromChapter": 25
  },
  {
    "who": "liuqingwu",
    "trait": "验字时先对着灯看纸角是否洇墨，再从第一个字看到最后一个",
    "fromChapter": 25
  },
  {
    "who": "laozhou",
    "trait": "用缺两根指头的手蘸水在废纸上画字，画到一半停住再画另一头，画完用手掌抹掉",
    "fromChapter": 25
  },
  {
    "who": "shenyan",
    "trait": "写字起笔不顿、一落就走，撇的收笔往下带；三年前写「沈」字三点水第一点起得高，现在起得低",
    "fromChapter": 26
  },
  {
    "who": "laozhou",
    "trait": "写字收笔往上挑钩",
    "fromChapter": 26
  },
  {
    "who": "liuqingwu",
    "trait": "问一句停三息再问，数息比钟还准；记笔三下一样重",
    "fromChapter": 26
  },
  {
    "who": "阿满",
    "trait": "本章出现的“阿满”双脚并齐站得正，与真阿满撇了二十年的站姿不同。",
    "fromChapter": 27
  },
  {
    "who": "玄清",
    "trait": "说话慢，每个字都清楚，一个字一个字往外放。",
    "fromChapter": 27
  },
  {
    "who": "xuanqing",
    "trait": "说话慢，每个字放得稳，一个字一个字往外放，像把册子一本一本码齐",
    "fromChapter": 28
  },
  {
    "who": "aman",
    "trait": "说话前先咬嘴唇，像后悔说出来；手在背后绞着，肩膀一动一动",
    "fromChapter": 28
  },
  {
    "who": "shenyan",
    "trait": "抄《云台县志》时遇到“秋”字收笔要往回带半笔回锋，改不掉",
    "fromChapter": 28
  },
  {
    "who": "liuqingwu",
    "trait": "走路三下一样重，走三步停一停。",
    "fromChapter": 29
  },
  {
    "who": "liuqingwu",
    "trait": "看墨时低头一寸、鼻翼动一下闻墨。",
    "fromChapter": 29
  },
  {
    "who": "laozhou",
    "trait": "走路两短一长，右脚落得轻，踩泥没声。",
    "fromChapter": 29
  },
  {
    "who": "shenyan",
    "trait": "写字起笔从不顿，一落就走；钩往下带；写三点水不连。",
    "fromChapter": 21
  },
  {
    "who": "shenyan",
    "trait": "掐墨锭时掐锭腰，不掐锭头。",
    "fromChapter": 21
  },
  {
    "who": "shenyan",
    "trait": "右手小指和无名指是僵的，掰不动，使不上力。",
    "fromChapter": 21
  },
  {
    "who": "老周",
    "trait": "上楼数级，两短一长，右脚落得轻，数到十级就停住不上来",
    "fromChapter": 30
  },
  {
    "who": "阿满",
    "trait": "站在低半分的砖上，两脚并齐，左脚一直没撇，挪步时脚跟先着地没声",
    "fromChapter": 30
  },
  {
    "who": "沈砚",
    "trait": "写字从右往左写，先写最后一笔",
    "fromChapter": 30
  }
]
